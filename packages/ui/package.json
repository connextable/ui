{
  "name": "@connextable/ui",
  "version": "0.1.0",
  "type": "module",
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json && vue-tsc -p tsconfig.integrations.json"
  },
  "dependencies": {
    "@lucide/vue": "catalog:",
    "@sectile/chart": "0.16.1",
    "@sectile/core": "0.16.1",
    "@sectile/form": "0.15.2",
    "@sectile/tabular": "0.17.1",
    "@sectile/temporal": "0.16.0",
    "@sectile/virtual": "0.16.1",
    "@sectile/vue": "0.22.0",
    "vue-router": "^5.5.1"
  },
  "peerDependencies": {
    "nuxt": "^4.5.0",
    "unimport": "^7.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.3.0 || ^8.0.0",
    "vue": "^3.5.41"
  },
  "peerDependenciesMeta": {
    "nuxt": { "optional": true },
    "unimport": { "optional": true },
    "unplugin-vue-components": { "optional": true },
    "vite": { "optional": true }
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.11",
    "nuxt": "4.6.4",
    "typescript": "catalog:",
    "unimport": "7.0.3",
    "unplugin-vue-components": "32.1.0",
    "vite": "8.3.8",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
