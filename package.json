{
  "name": "connextable-ui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "pnpm check:copy && pnpm -r build",
    "check:copy": "node scripts/check-copy.mjs",
    "dev": "dvt run dev:docs",
    "typecheck": "pnpm check:copy && pnpm --filter @connextable/ui build && pnpm --filter @connextable/ui-docs typecheck"
  }
}
